diff --git a/ds4_metal.m b/ds4_metal.m
index ab3337e..38b02e9 100644
--- a/ds4_metal.m
+++ b/ds4_metal.m
@@ -5,5 +5,6 @@
 #include <stdint.h>
 #include <inttypes.h>
+#include <stddef.h>
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -4363,9 +4364,20 @@ int ds4_gpu_host_memory_snapshot(ds4_ssd_host_memory *out) {
         (host_info64_t)&vm,
         &vm_count);
     (void)mach_port_deallocate(mach_task_self(), host);
+    /* Darwin may return an older, shorter vm_statistics64 revision than the
+     * SDK's padded latest structure.  The fields used below (including
+     * external_page_count) are present in the returned rev3 count on the
+     * affected M1/macOS combination, so requiring the padded latest count
+     * incorrectly makes the live SSD admission snapshot unavailable. */
+    const mach_msg_type_number_t required_vm_count =
+        (mach_msg_type_number_t)((offsetof(vm_statistics64_data_t,
+                                            external_page_count) +
+                                   sizeof(vm.external_page_count) +
+                                   sizeof(integer_t) - 1) /
+                                  sizeof(integer_t));
     if (page_kr != KERN_SUCCESS ||
         vm_kr != KERN_SUCCESS ||
         page_size == 0 ||
-        vm_count < HOST_VM_INFO64_COUNT) {
+        vm_count < required_vm_count) {
         return 0;
     }
